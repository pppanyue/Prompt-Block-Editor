{
  "name": "prompt-block-editor",
  "version": "0.2.0",
  "private": true,
  "description": "A visual prompt editor for image and video generation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
